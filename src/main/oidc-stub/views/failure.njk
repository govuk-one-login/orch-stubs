{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

<h2 class="govuk-heading-m">Error response</h2>
<p>Return an OIDC error response.</p>

<form method="POST" action="{{ interactionUid }}/error">
  {{ govukSelect({
    id: "error",
    name: "error",
    label: {
      text: "Error code"
    },
    items: [
      {
        value: "access_denied",
        text: "access_denied",
        selected: true
      },
      {
        value: "server_error",
        text: "server_error"
      }
    ]
  }) }}

  {{ govukInput({
    label: {
      text: "Error description"
    },
    id: "error_description",
    name: "error_description",
    value: "Error generated by OIDC stub"
  }) }}

  {{ govukRadios({
    name: "errorWhere",
    fieldset: {
      legend: {
        text: "Where should the error be returned?"
      }
    },
    items: [
      {
        value: "authorize",
        text: "Authorize redirect",
        checked: true
      },
      {
        value: "token",
        text: "Token exchange"
      },
      {
        value: "userinfo",
        text: "Userinfo response"
      }
    ]
  }) }}

  {{ govukButton({
    text: "Continue with error"
  }) }}
</form>
