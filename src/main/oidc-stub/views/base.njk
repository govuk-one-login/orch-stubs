{% extends "govuk/template.njk" %}

{% block head %}
    <link href="/assets/govuk-frontend.min.css" rel="stylesheet">
    {% block headMetaData %}{% endblock %}
{% endblock %}

{% block pageTitle %}
    {% if pageTitle %}{{ pageTitle }} – GOV.UK One Login{% endif %}
{% endblock %}

{% block header %}
  {{ govukHeader({
    homepageUrl: "/"
  }) }}
{% endblock %}

{% block main %}
    <div class="govuk-width-container {{ containerClasses }}">
        {% block beforeContent %}{% endblock %}
        <main class="govuk-main-wrapper {{ mainClasses }}" id="main-content">
            <div class="govuk-grid-row">
                <div class="govuk-grid-column-two-thirds {{ rowClasses }}">
                    {% block content %}{% endblock %}
                </div>
            </div>
        </main>
    </div>
{% endblock %}

{% block footer %}
    {{ govukFooter({}) }}
{% endblock %}

{% block bodyEnd %}
  {% block scripts %}{% endblock %}
  <script type="module" src="/assets/govuk-frontend.min.js"></script>
  <script type="module">
    import { initAll } from '/assets/govuk-frontend.min.js'
    initAll()
  </script>
{% endblock %}
